{
    "info": {
        "name": "Kitty Chat WebSocket API - Updated",
        "description": "Updated WebSocket collection for testing Kitty Chat real-time messaging functionality",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "_postman_id": "kitty-chat-websocket-updated"
    },
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Register User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"{{user_name}}\",\n  \"email\": \"{{user_email}}\",\n  \"phoneNumber\": \"{{user_phone}}\",\n  \"password\": \"{{user_password}}\",\n  \"confirmPassword\": \"{{user_password}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/auth/registration",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "auth", "registration"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// Extract token from response",
                                    "if (pm.response.code === 201) {",
                                    "    const responseJson = pm.response.json();",
                                    "    if (responseJson.result && responseJson.result.token) {",
                                    "        pm.environment.set('jwt_token', responseJson.result.token);",
                                    "        pm.environment.set('user_id', responseJson.result.id);",
                                    "        pm.environment.set('user_uuid', responseJson.result.uuid);",
                                    "        console.log('Token saved:', responseJson.result.token);",
                                    "    }",
                                    "}",
                                    "",
                                    "pm.test('Registration successful', function () {",
                                    "    pm.response.to.have.status(201);",
                                    "});"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Login User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"emailOrPhone\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/auth/login",
                            "host": ["{{base_url}}"],
                            "path": ["api", "v1", "auth", "login"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// Extract token from response",
                                    "if (pm.response.code === 200) {",
                                    "    const responseJson = pm.response.json();",
                                    "    if (responseJson.result && responseJson.result.token) {",
                                    "        pm.environment.set('jwt_token', responseJson.result.token);",
                                    "        pm.environment.set('user_id', responseJson.result.id);",
                                    "        pm.environment.set('user_uuid', responseJson.result.uuid);",
                                    "        console.log('Token saved:', responseJson.result.token);",
                                    "    }",
                                    "}",
                                    "",
                                    "pm.test('Login successful', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "WebSocket Chat",
            "item": [
                {
                    "name": "Chat WebSocket Connection",
                    "request": {
                        "method": "WEBSOCKET",
                        "header": [],
                        "url": {
                            "raw": "{{websocket_url}}/socket.io/?EIO=4&transport=websocket&ns=/chat",
                            "host": ["{{websocket_url}}"],
                            "path": ["socket.io"],
                            "query": [
                                {
                                    "key": "EIO",
                                    "value": "4"
                                },
                                {
                                    "key": "transport",
                                    "value": "websocket"
                                },
                                {
                                    "key": "ns",
                                    "value": "/chat"
                                }
                            ]
                        }
                    },
                    "description": "Connect to the chat WebSocket server using Socket.io v4 protocol with /chat namespace."
                }
            ]
        }
    ],
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Set default values if not present",
                    "if (!pm.environment.get('base_url')) {",
                    "    pm.environment.set('base_url', 'http://localhost:3001');",
                    "}",
                    "if (!pm.environment.get('websocket_url')) {",
                    "    pm.environment.set('websocket_url', 'ws://localhost:3001');",
                    "}"
                ]
            }
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:3001",
            "type": "string"
        },
        {
            "key": "websocket_url",
            "value": "ws://localhost:3001",
            "type": "string"
        }
    ]
}
